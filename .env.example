APP_ENV=local

DB_HOST=127.0.0.1
DB_PORT=5432
DB_NAME=profilepath
DB_USER=postgres
DB_PASSWORD=changeme

# 32 random bytes, base64-encoded. Generate with:
#   php -r "echo base64_encode(random_bytes(32));"
APP_AES_KEY=

# Brevo (formerly Sendinblue) free tier SMTP relay — 300 emails/day free.
# Sign up at https://www.brevo.com, create an SMTP key under Settings > SMTP & API.
SMTP_HOST=smtp-relay.brevo.com
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=no-reply@profilepath.local
SMTP_FROM_NAME=ProfilePath

APP_URL=http://localhost:8000
